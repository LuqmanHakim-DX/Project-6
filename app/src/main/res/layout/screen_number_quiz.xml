<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9C4">

    <!-- 1. Imej Background (Taman Tema) -->
    <ImageView
        android:id="@+id/img_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/num_gameplay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Butang Pause (Kecil di atas kanan) -->
    <ImageButton
        android:id="@+id/btn_pause"
        android:layout_width="47dp"
        android:layout_height="47dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="#FFB300"
        android:src="@android:drawable/ic_media_pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. Kotak Soalan Ungu -->
    <TextView
        android:id="@+id/tv_question"
        android:layout_width="300dp"
        android:layout_height="200dp"
        android:layout_marginTop="100dp"
        android:background="#673AB7"
        android:gravity="center"
        android:text="5 + 3 = ?"
        android:textColor="#FFFFFF"
        android:textSize="45sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 4. Grid Jawapan (Susunan 2x2) -->

    <!-- Jawapan 1 (Atas Kiri) -->
    <Button
        android:id="@+id/btn_ans1"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="10dp"
        android:backgroundTint="#4DD0E1"
        android:text="4"
        android:textColor="#000000"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/btn_ans2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_question" />

    <!-- Jawapan 2 (Atas Kanan) -->
    <Button
        android:id="@+id/btn_ans2"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:backgroundTint="#4DD0E1"
        android:text="7"
        android:textColor="#000000"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btn_ans1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_ans1"
        app:layout_constraintTop_toTopOf="@+id/btn_ans1" />

    <!-- Jawapan 3 (Bawah Kiri) -->
    <Button
        android:id="@+id/btn_ans3"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#4DD0E1"
        android:text="8"
        android:textColor="#000000"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/btn_ans1"
        app:layout_constraintTop_toBottomOf="@+id/btn_ans1" />

    <!-- Jawapan 4 (Bawah Kanan) -->
    <Button
        android:id="@+id/btn_ans4"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:backgroundTint="#4DD0E1"
        android:text="2"
        android:textColor="#000000"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btn_ans3"
        app:layout_constraintStart_toStartOf="@+id/btn_ans2"
        app:layout_constraintTop_toTopOf="@+id/btn_ans3" />

</androidx.constraintlayout.widget.ConstraintLayout>